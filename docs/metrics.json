{
  "project": "op_customer_360",
  "title": "Customer 360 metrics",
  "suggested": [
    "How many customers do we have?",
    "Total revenue by current interest",
    "Missed payments by payment remark",
    "Insurance claims by current interest",
    "Monthly average revenue by interest"
  ],
  "metrics": [
    {"name": "customers", "label": "Customers", "description": "Customers on the 360."},
    {"name": "total_revenue", "label": "Total revenue", "description": "Sum of total_revenue_eur."},
    {"name": "avg_monthly_revenue", "label": "Monthly avg revenue", "description": "Sum of monthly_avg_revenue_eur."},
    {"name": "missed_payments", "label": "Missed payments", "description": "Sum of banking missed payments."},
    {"name": "open_claims", "label": "Insurance claims", "description": "Sum of insurance claims opened."}
  ],
  "dimensions": [
    {"name": "customer__current_interest", "label": "Current interest"},
    {"name": "customer__banking_payment_remark", "label": "Payment remark"}
  ],
  "intents": [
    {
      "match": ["how many customer", "customer count", "number of customer"],
      "metrics": ["customers"]
    },
    {
      "match": ["revenue", "total revenue", "by interest"],
      "metrics": ["customers", "total_revenue"],
      "groupBy": ["customer__current_interest"]
    },
    {
      "match": ["missed payment", "payment remark"],
      "metrics": ["customers", "missed_payments"],
      "groupBy": ["customer__banking_payment_remark"]
    },
    {
      "match": ["claim", "insurance claim"],
      "metrics": ["customers", "open_claims"],
      "groupBy": ["customer__current_interest"]
    },
    {
      "match": ["monthly", "average revenue"],
      "metrics": ["avg_monthly_revenue", "customers"],
      "groupBy": ["customer__current_interest"]
    }
  ]
}
